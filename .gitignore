# ═══════════════════════════════════════════════════════════
#  📡 Stream Recorder — .gitignore
# ═══════════════════════════════════════════════════════════

# Media files (never commit recordings)
*.mp4
*.webm
*.mkv
*.ts
!dashboard/**/*.ts
*.m4a
*.flv
*.part
*.ytdl

# Cookie files (contains sensitive data)
cookies.txt
cookies_encoded.txt

# Temporary files
/tmp/
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache
__pycache__/
*.pyc

# Debug/test dumps (never commit)
dump.json
output.json
cookie_keepalive.json
lofi.html
sava.html

scripts/mega/signin_results.json
scripts/mega/.last_account_index
scripts/mega/accounts.old.csv
.megarc

# SECURITY: Cloud account CSVs (contain credentials — never commit)
scripts/mega/accounts.csv
scripts/pixeldrain/accounts.csv
scripts/mega/signin_results.json
scripts/mega/.last_account_index
scripts/mega/accounts.old.csv

# Agent skills — local toolkit only, never part of the repo
.agents/
skills-lock.json
