#!/usr/bin/env bash
# yt-dlp mock.
out=""; dumpjson=0; geturl=0; print_arg=""
i=0; args=("$@")
while [[ $i -lt ${#args[@]} ]]; do
  case "${args[$i]}" in
    -o) out="${args[$((i+1))]}"; i=$((i+2)) ;;
    --dump-json) dumpjson=1; i=$((i+1)) ;;
    -g) geturl=1; i=$((i+1)) ;;
    --print) print_arg="${args[$((i+1))]}"; i=$((i+2)) ;;
    *) i=$((i+1)) ;;
  esac
done
if [[ $dumpjson -eq 1 ]]; then
  echo '{"id":"dQw4w9WgXcQ","title":"Test Live Stream","is_live":true,"live_status":"is_live","thumbnail":"https://i.ytimg.com/vi/dQw4w9WgXcQ/maxresdefault.jpg","channel":"The Muslim Lantern","uploader":"The Muslim Lantern"}'
  exit 0
fi
if [[ $geturl -eq 1 ]]; then echo "https://example.com/fake_playlist.m3u8"; exit 0; fi
if [[ -n "$print_arg" ]]; then
  case "$print_arg" in
    *id*) echo "dQw4w9WgXcQ" ;;
    *title*) echo "Test Live Stream" ;;
    *) echo "unknown" ;;
  esac
  exit 0
fi
if [[ -n "$out" ]]; then head -c 30000000 /dev/zero > "$out" 2>/dev/null; fi
exit 0
