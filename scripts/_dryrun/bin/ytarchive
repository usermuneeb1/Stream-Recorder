#!/usr/bin/env bash
# ytarchive mock: writes <base>.mp4 (matches what record_method_h expects).
out=""; i=0; args=("$@")
while [[ $i -lt ${#args[@]} ]]; do
  [[ "${args[$i]}" == "--output" ]] && out="${args[$((i+1))]}"
  i=$((i+1))
done
[[ -n "$out" ]] && head -c 25000000 /dev/zero > "${out}.mp4" 2>/dev/null
exit 0
